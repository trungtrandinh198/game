# Sao chép thành .env và điền giá trị. Không commit .env.
NODE_ENV=development
LOG_LEVEL=info

APP_BASE_URL=http://localhost:3000
REALTIME_PUBLIC_URL=ws://localhost:2567

# PostgreSQL + PostGIS (role tách theo quyền, mục 7.11)
# Supabase: dùng chuỗi "Session pooler" (IPv4) trong Connect, ví dụ
#   postgresql://postgres.<ref>:<mật khẩu>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Host trực tiếp db.<ref>.supabase.co chỉ có IPv6 nên nhiều mạng không kết nối được.
# Supabase chỉ có một database nên TEST_DATABASE_URL có thể trỏ cùng DB; test tự tạo schema riêng rồi xóa.
DATABASE_URL=postgres://dnw_api:dnw_api_dev@localhost:5432/dnw
REALTIME_DATABASE_URL=postgres://dnw_realtime:dnw_realtime_dev@localhost:5432/dnw
MIGRATION_DATABASE_URL=postgres://dnw_migrator:dnw_migrator_dev@localhost:5432/dnw
TEST_DATABASE_URL=postgres://dnw_migrator:dnw_migrator_dev@localhost:5432/dnw_test

REDIS_URL=redis://localhost:6379

# Session
SESSION_COOKIE_NAME=dnw_sid
SESSION_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=30
REQUIRE_EMAIL_VERIFICATION=false

# Join ticket giữa api và realtime: tối thiểu 32 byte ngẫu nhiên (ví dụ: openssl rand -base64 48)
REALTIME_TICKET_SECRET=

# Realtime
ROOM_CAPACITY=30
PROTOCOL_VERSION=1

# Object storage (MinIO khi dev) và CDN
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dnw-assets
S3_ACCESS_KEY_ID=dnwadmin
S3_SECRET_ACCESS_KEY=dnwadmin-dev-password
# Dev không MinIO: CDN_BASE_URL=http://localhost:3000/dev/map-data và MAP_SOURCE=dist/maps
CDN_BASE_URL=http://localhost:9000/dnw-assets

# Email (Mailpit khi dev)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Da Nang World <no-reply@localhost>"

# Giám sát (để trống khi dev)
SENTRY_DSN=
